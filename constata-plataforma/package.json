{
  "name": "constata-plataforma",
  "private": true,
  "description": "CONSTATA: plataforma de estudios laborales, organizada en mini apps independientes.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:sitio": "npm run dev -w @constata/sitio",
    "build:sitio": "npm run build -w @constata/sitio",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
